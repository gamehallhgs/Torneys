# Copia este ficheiro para ".env" (Linux: cp .env.example .env | Windows: copy .env.example .env)
# Os valores abaixo servem APENAS para desenvolvimento local. NUNCA os uses em produção
# (a API recusa arrancar em Production com valores que contenham "dev-only").
#
# Para gerar segredos fortes (produção):
#   Linux/macOS:  openssl rand -base64 48
#   Windows PS:   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])

POSTGRES_PASSWORD=dev-only-postgres-password
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-0123456789abcdef
PASSWORD_PEPPER=dev-only-password-pepper-change-me-0123456789
