<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameHall.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Npgsql" Version="9.*" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <!-- Dependência indireta (MailKit) com vulnerabilidade conhecida na 10.0.0: forçamos a última 10.0.x. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Textos legais e migrações SQL são copiados para a pasta de saída -->
    <Content Include="Legal\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Database\Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
